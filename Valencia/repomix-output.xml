    page.get_by_role("button", name=re.compile(r"Acceptar|Aceptar")).click()  # Aceptar
    page.wait_for_load_state("networkidle")

    page.get_by_role("link", name="Seleccionar").nth(
        0
    ).click()  # Primer "Seleccionar" que aparece(los anteriores han cambiado de nombre)
    page.wait_for_load_state("networkidle")

    # Subir el archivo
    page.locator('[id="uploadForm:upload"]').set_input_files(archivo_path)

    page.get_by_role("button", name=re.compile(r"Acceptar|Aceptar")).click()  # Aceptar
    page.wait_for_load_state("networkidle")

    time.sleep(10)  # Esperar para revisar los datos antes de cerrar el navegador
    # --------------------------------------------------------------------------------
    # ------------------------------FALTA EL SOLICITA!!!------------------------------
    # --------------------------------------------------------------------------------
    context.close()
    browser.close()
