def split_full_name(full_name: str):
    """
    Divide un nombre completo en Nombre, Apellido1, Apellido2.
    Las partículas (de, del, de la, y, van, von, ...) se incluyen en Apellido2.
    """
    if not full_name or not full_name.strip():
        return "", "", ""

    tokens = full_name.strip().split()
    n = len(tokens)

    if n == 1:
        return tokens[0], "", ""
    if n == 2:
        return tokens[0], tokens[1], ""

    # Partículas que suelen empezar el apellido2
    particulas = {
        "de",
        "del",
        "la",
        "las",
        "los",
        "y",
        "van",
        "von",
        "mc",
        "mac",
        "san",
        "santa",
    }

    # Último token siempre entra en Apellido2
    apellido2_tokens = [tokens[-1]]
    i = n - 2

    # Retrocedemos para ver si hay partículas que se deben unir al apellido2
    while i >= 0 and tokens[i].lower() in particulas:
        apellido2_tokens.insert(0, tokens[i])
        i -= 1

    apellido2 = " ".join(apellido2_tokens)

    # El penúltimo token no incluido en apellido2 es Apellido1
    apellido1 = tokens[i] if i >= 0 else ""

    # El resto es el nombre
    nombre_tokens = tokens[:i]
    nombre = " ".join(nombre_tokens)

    return nombre, apellido1, apellido2
