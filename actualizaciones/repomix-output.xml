        await page1.get_by_role(
            "tab", name=re.compile(r"Multes", re.IGNORECASE)
        ).first.click()
        logger.info("ajuntament_barcelona.multes tab_multes clicked via role")
    try:
        await page1.wait_for_load_state("networkidle", timeout=5000)
    except Exception:
