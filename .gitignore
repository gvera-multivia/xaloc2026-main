# .gitignore para Xaloc Automation

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
out/
sync_sqlserver_config.json
env/
ENV/
.venv
.env
morrigan-electron/.env.example
# Playwright
.pytest_cache/

# Logs
logs/*.log
*.log

# Screenshots (pueden contener datos sensibles)
screenshots/*.png
screenshots/*.jpg

# Perfiles de navegador (contienen certificados)
profiles/

# Archivos de prueba con datos reales
test_files/*.pdf
test_files/*.doc
test_files/*.docx

# Mantener archivos de ejemplo
!test_files/documento_prueba.txt
!test_files/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Configuración local
config_local.py

certificates/*
.playwright-cli/*

*.png
*.pdf

# Codex local configuration
.codex/

# Claude Flow runtime data
.claude-flow/data/
.claude-flow/logs/

# Environment variables
.env
.env.local
.env.*.local

.agents/*
.claude/*
.codex/*
.claude-flow/*
.swarm/*
logs/*
*.db
tmp/*
*.gpkg