VITE_MORRIGAN_API_BASE_URL=http://192.168.184.72:8080
VITE_MORRIGAN_WS_URL=ws://192.168.184.72:8080/ws/dashboard
VITE_MORRIGAN_BOOTSTRAP_URL=http://192.168.184.72:8080/morrigan-config.json
VITE_MORRIGAN_CONFIG_REFRESH_SEC=120
VITE_MORRIGAN_APP_NAME=Morrigan
VITE_MORRIGAN_LOG_LEVEL=info

# ── Auto-updater (Fase 3) ──────────────────────────────────────────────────────
# URL base del servidor que sirve latest.yml y los paquetes delta.
# Si no está definida, el auto-updater se desactiva silenciosamente (fail-safe).
# Ejemplo: http://192.168.184.72:8080/updates
MORRIGAN_UPDATE_URL=

# Permite probar auto-updater en desarrollo (app no empaquetada).
# Requiere MORRIGAN_UPDATE_URL valido y, para ciertos flujos de electron-updater,
# un archivo dev-app-update.yml.
MORRIGAN_UPDATER_TEST_MODE=0
