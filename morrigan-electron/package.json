{
  "name": "morrigan-electron",
  "version": "0.1.0",
  "description": "Morrigan - Aplicacion de escritorio Xaloc",
  "author": "Xaloc",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && tsc -p tsconfig.node.json && electron .",
    "build:renderer": "vite build",
    "build:electron": "node build/build-main.mjs",
    "build:electron:dev": "tsc -p tsconfig.node.json",
    "typecheck": "tsc -p tsconfig.node.json --noEmit",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:nsis": "npm run build && electron-builder --win nsis --x64 --config electron-builder.yml",
    "dist:msi": "npm run build && electron-builder --win msi --x64 --config electron-builder.yml",
    "dist:dir": "npm run build && electron-builder --win --dir --config electron-builder.yml",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@tanstack/react-query": "^5.56.2",
    "@types/node": "^22.5.4",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "@vitejs/plugin-react": "^4.3.1",
    "axios": "^1.7.7",
    "concurrently": "^9.0.1",
    "electron": "^31.6.0",
    "electron-builder": "^25.0.5",
    "esbuild": "^0.27.3",
    "eslint": "^9.9.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sharp": "^0.34.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vitest": "^2.1.1",
    "wait-on": "^8.0.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  }
}